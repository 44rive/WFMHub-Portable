	column 'Evaluation As Of'
		dataType: string
		summarizeBy: none
		sourceColumn: Evaluation As Of

	partition 'Status' = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(HubRoot & "\Feed\PowerBI\FactStatusInterval.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Selected = Table.SelectColumns(Promoted, {"Date", "Segment Key", "Agent Day Key", "Agent ID", "Agent", "Team Leader", "Ops Manager", "LOB", "Management LOB", "Language", "Scheduled Start", "Scheduled End", "Segment Start", "Segment End", "Time Slot", "Minutes", "Planned State", "Actual Status", "Attendance Category", "AUX Classification", "Qualification 1", "Qualification 2", "Operational Category", "Mismatch", "Is Gap", "Observed Source", "Shift State", "Is Planned Time Off", "Is Observed", "Is Productive", "Is Unexplained", "Is Status Mapped", "Evaluation As Of"}, MissingField.Error),
			    NullBlanks = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Date", "Time Slot", "Minutes", "Is Gap", "Is Planned Time Off", "Is Observed", "Is Productive", "Is Unexplained", "Is Status Mapped"}),
			    Typed = Table.TransformColumnTypes(NullBlanks, {{"Date", type date}, {"Segment Key", type text}, {"Agent Day Key", type text}, {"Agent ID", type text}, {"Agent", type text}, {"Team Leader", type text}, {"Ops Manager", type text}, {"LOB", type text}, {"Management LOB", type text}, {"Language", type text}, {"Scheduled Start", type text}, {"Scheduled End", type text}, {"Segment Start", type text}, {"Segment End", type text}, {"Time Slot", Int64.Type}, {"Minutes", Int64.Type}, {"Planned State", type text}, {"Actual Status", type text}, {"Attendance Category", type text}, {"AUX Classification", type text}, {"Qualification 1", type text}, {"Qualification 2", type text}, {"Operational Category", type text}, {"Mismatch", type text}, {"Is Gap", Int64.Type}, {"Observed Source", type text}, {"Shift State", type text}, {"Is Planned Time Off", Int64.Type}, {"Is Observed", Int64.Type}, {"Is Productive", Int64.Type}, {"Is Unexplained", Int64.Type}, {"Is Status Mapped", Int64.Type}, {"Evaluation As Of", type text}}, "en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
