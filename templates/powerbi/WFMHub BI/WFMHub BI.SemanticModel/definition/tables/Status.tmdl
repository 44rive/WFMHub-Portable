/// Agent Status-first governed shift segments with reviewed AUX classification.
table 'Status'

	/// Completed scheduled minutes excluding governed PTO/Away.
	measure 'Elapsed Scheduled Minutes' = ```
			CALCULATE(SUM('Status'[Minutes]), 'Status'[Shift State] = "COMPLETE", 'Status'[Is Planned Time Off] = 0)
			```
		formatString: #,##0
		displayFolder: 'Workforce realisation'

	/// Completed elapsed minutes with observed connected evidence.
	measure 'Observed Minutes' = ```
			CALCULATE(SUM('Status'[Minutes]), 'Status'[Shift State] = "COMPLETE", 'Status'[Is Planned Time Off] = 0, 'Status'[Is Observed] = 1)
			```
		formatString: #,##0
		displayFolder: 'Workforce realisation'

	/// Completed voice, BO and other governed productive minutes; Available remains separate.
	measure 'Productive Minutes' = ```
			CALCULATE(SUM('Status'[Minutes]), 'Status'[Shift State] = "COMPLETE", 'Status'[Is Planned Time Off] = 0, 'Status'[Is Productive] = 1)
			```
		formatString: #,##0
		displayFolder: 'Workforce realisation'

	/// Completed scheduled minutes with logged-off, no-activity or missing-status evidence.
	measure 'Unexplained Minutes' = ```
			CALCULATE(SUM('Status'[Minutes]), 'Status'[Shift State] = "COMPLETE", 'Status'[Is Planned Time Off] = 0, 'Status'[Is Unexplained] = 1)
			```
		formatString: #,##0
		displayFolder: 'Workforce realisation'

	/// Completed elapsed scheduled hours excluding governed PTO/Away.
	measure 'Elapsed Scheduled Hours' = ```
			DIVIDE([Elapsed Scheduled Minutes], 60)
			```
		formatString: #,##0.0
		displayFolder: 'Workforce realisation'

	/// Observed connected hours in completed shifts.
	measure 'Observed Hours' = ```
			DIVIDE([Observed Minutes], 60)
			```
		formatString: #,##0.0
		displayFolder: 'Workforce realisation'

	/// Governed productive hours in completed shifts.
	measure 'Productive Hours' = ```
			DIVIDE([Productive Minutes], 60)
			```
		formatString: #,##0.0
		displayFolder: 'Workforce realisation'

	/// Unexplained scheduled hours requiring evidence review.
	measure 'Unexplained Hours' = ```
			DIVIDE([Unexplained Minutes], 60)
			```
		formatString: #,##0.0
		displayFolder: 'Workforce realisation'

	/// Observed minutes divided by elapsed scheduled minutes.
	measure 'Presence Realisation %' = ```
			DIVIDE([Observed Minutes], [Elapsed Scheduled Minutes])
			```
		formatString: 0.0%
		displayFolder: 'Workforce realisation'

	/// Governed productive minutes divided by observed minutes.
	measure 'Productive Realisation %' = ```
			DIVIDE([Productive Minutes], [Observed Minutes])
			```
		formatString: 0.0%
		displayFolder: 'Workforce realisation'

	/// Governed productive minutes divided by elapsed scheduled minutes.
	measure 'Capacity Delivered %' = ```
			DIVIDE([Productive Minutes], [Elapsed Scheduled Minutes])
			```
		formatString: 0.0%
		displayFolder: 'Workforce realisation'

	/// Hours in the selected governed operational category.
	measure 'Status Hours' = ```
			DIVIDE(SUM('Status'[Minutes]), 60)
			```
		formatString: #,##0.0
		displayFolder: 'Workforce realisation'

	/// Mapped Agent Status minutes divided by Agent Status minutes.
	measure 'Status Mapped %' = ```
			DIVIDE(CALCULATE(SUM('Status'[Minutes]), 'Status'[Observed Source] = "AGENT_STATUS", 'Status'[Is Status Mapped] = 1), CALCULATE(SUM('Status'[Minutes]), 'Status'[Observed Source] = "AGENT_STATUS"))
			```
		formatString: 0.0%
		displayFolder: 'Data quality'

	/// Elapsed scheduled hours not delivered as governed productive hours.
	measure 'Capacity Loss Hours' = ```
			MAX([Elapsed Scheduled Hours] - [Productive Hours], 0)
			```
		formatString: #,##0.0
		displayFolder: 'Driver signals'

	/// Auditable capacity bridge values by selected stage.
	measure 'Capacity Bridge Hours' = ```
			SWITCH(SELECTEDVALUE('Capacity Stage'[Capacity Stage]), "Elapsed scheduled", [Elapsed Scheduled Hours], "Absence / missing", -MAX([Elapsed Scheduled Hours]-[Observed Hours],0), "Observed", [Observed Hours], "AUX / available / breaks", -MAX([Observed Hours]-[Productive Hours],0), "Productive", [Productive Hours])
			```
		formatString: #,##0.0;[Red]-#,##0.0
		displayFolder: 'Workforce realisation'

	column 'Date'
		dataType: dateTime
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Date

	column 'Segment Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Segment Key

	column 'Agent Day Key'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Agent Day Key

	column 'Agent ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: Agent ID

	column 'Agent'
		dataType: string
		summarizeBy: none
		sourceColumn: Agent

	column 'Team Leader'
