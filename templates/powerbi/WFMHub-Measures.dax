// AUDIT REFERENCE — generated by tools/build_powerbi_project.py
// The live measures are stored beside their owning facts in WFMHub BI.SemanticModel/definition/tables.
// Ratios always divide summed governed components; Power BI does not reclassify source data.

// Service
Offered Calls = SUM('Service'[Offered])
Answered Calls = SUM('Service'[Answered])
Abandoned Calls = SUM('Service'[Abandoned])
Handled in SL = SUM('Service'[Answered Within Target])
SLA Eligible Calls = SUM('Service'[SLA Denominator])
Service Level % = DIVIDE([Handled in SL], [SLA Eligible Calls])
Routing Availability % = DIVIDE([Answered Calls], [Offered Calls])
Abandon Rate % = DIVIDE([Abandoned Calls], [Offered Calls])
AHT Seconds = DIVIDE(SUM('Service'[Handled Seconds]), [Answered Calls])
Volume Variance = [Offered Calls] - [Forecast Volume]
Volume Variance % = DIVIDE([Volume Variance], [Forecast Volume])

// Forecast
Forecast Volume = SUM('Forecast'[Volume Forecast])
Required FTE = AVERAGEX(SUMMARIZE('Forecast', 'Forecast'[Date], 'Forecast'[Time Slot], "Interval FTE", SUM('Forecast'[FTE Required])), [Interval FTE])

// Staffing
Average Scheduled FTE = AVERAGEX(SUMMARIZE('Staffing', 'Staffing'[Date], 'Staffing'[Time Slot], "Interval FTE", SUM('Staffing'[Scheduled FTE])), [Interval FTE])
Average Observed FTE = AVERAGEX(SUMMARIZE('Staffing', 'Staffing'[Date], 'Staffing'[Time Slot], "Interval FTE", SUM('Staffing'[Observed FTE])), [Interval FTE])
Average Productive FTE = AVERAGEX(SUMMARIZE('Staffing', 'Staffing'[Date], 'Staffing'[Time Slot], "Interval FTE", SUM('Staffing'[Productive FTE])), [Interval FTE])
Capacity Gap FTE = MAX([Required FTE] - [Average Scheduled FTE], 0)
Observed Gap FTE = MAX([Average Scheduled FTE] - [Average Observed FTE], 0)
Coverage % = DIVIDE([Average Scheduled FTE], [Required FTE])

// Attendance
Due HC = CALCULATE(DISTINCTCOUNT('Attendance'[Agent Day Key]), 'Attendance'[Planned Work Minutes] > 0)
Present HC = CALCULATE(DISTINCTCOUNT('Attendance'[Agent Day Key]), 'Attendance'[Planned Work Minutes] > 0, 'Attendance'[First Login] <> BLANK(), 'Attendance'[First Login] <> "")
No Show HC = CALCULATE(DISTINCTCOUNT('Attendance'[Agent Day Key]), 'Attendance'[Attendance Result] = "No show")
Unknown / Possible No Show HC = MAX([Due HC] - [Present HC] - [No Show HC], 0)
Callout HC = CALCULATE(DISTINCTCOUNT('Attendance'[Agent Day Key]), 'Attendance'[Requires Call] = "1")
Late HC = CALCULATE(DISTINCTCOUNT('Attendance'[Agent Day Key]), 'Attendance'[Late Minutes] > 0)
Early Leave HC = CALCULATE(DISTINCTCOUNT('Attendance'[Agent Day Key]), 'Attendance'[Early Leave Minutes] > 0)
Attendance % = DIVIDE([Present HC], [Due HC])

// Attendance Gap
Total Gap Minutes = SUM('Attendance Gap'[Gap Minutes])

// PCS
PCS Average = DIVIDE(SUM('PCS'[PCS Score Sum]), SUM('PCS'[Valid PCS]))
PCS Participation % = DIVIDE(SUM('PCS'[PCS Participation Responses]), SUM('PCS'[PCS Status Calls]))
Valid PCS Responses = SUM('PCS'[Valid PCS])
Low Score Response Count = SUM('PCS'[Low Score Responses])
Top Box Response Count = SUM('PCS'[Top Box Responses])
PCS Index % = DIVIDE([PCS Average], 5)

// Time Off
PTO / Away HC = DISTINCTCOUNT('Time Off'[Agent Day Key])

// Final Absence
Final Planned Minutes = CALCULATE(SUM('Final Absence'[Planned Net Minutes]), 'Final Absence'[Final Ledger Status] IN {"CLEAR", "ABSENCE_RECORDED"})
Final Absence Minutes = CALCULATE(SUM('Final Absence'[Absence Minutes]), 'Final Absence'[Final Ledger Status] IN {"CLEAR", "ABSENCE_RECORDED"})
Final Shrinkage Minutes = CALCULATE(SUM('Final Absence'[Shrinkage Minutes]), 'Final Absence'[Final Ledger Status] IN {"CLEAR", "ABSENCE_RECORDED"})
Final PTO Minutes = CALCULATE(SUM('Final Absence'[Vacation Minutes]), 'Final Absence'[Final Ledger Status] IN {"CLEAR", "ABSENCE_RECORDED"})
Final Absence % = DIVIDE([Final Absence Minutes], [Final Planned Minutes])
Final Shrinkage % = DIVIDE([Final Shrinkage Minutes], [Final Planned Minutes])
Final PTO % = DIVIDE([Final PTO Minutes], [Final Planned Minutes])
Absence Review HC = CALCULATE(DISTINCTCOUNT('Final Absence'[Agent Day Key]), NOT('Final Absence'[Final Ledger Status] IN {"CLEAR", "ABSENCE_RECORDED"}))

// Absence Component
Activity Minutes = SUM('Absence Component'[Minutes])

// Finding
Finding Count = COUNTROWS('Finding')

// Source Health
Source Count = COUNTROWS('Source Health')
Sources Ready = CALCULATE(COUNTROWS('Source Health'), 'Source Health'[Status] IN {"OK", "READY", "LOADED"})
Latest Data Date = MAX('Source Health'[Newest Date])

// Quality Issue
Quality Issues = COUNTROWS('Quality Issue')
Critical Quality Issues = CALCULATE(COUNTROWS('Quality Issue'), 'Quality Issue'[Severity] IN {"ERROR", "CRITICAL"})
